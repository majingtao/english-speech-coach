# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Anthropic API Key (get from https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Moonshot (Kimi) API Key (get from https://platform.moonshot.cn/console/api-keys)
MOONSHOT_API_KEY=sk-...

# OpenRouter API Key (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# DeepSeek official API (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com

# HTTP Proxy for accessing OpenAI/Claude APIs (e.g. local Clash/V2Ray)
# Moonshot and OpenRouter usually no proxy needed
HTTP_PROXY=http://127.0.0.1:1080

# Optional: custom API base URLs
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---------- Deployment / network ----------
# Local dev: leave unset (defaults to 0.0.0.0) so you can open
# https://<your-lan-ip>:8443 from another device (e.g. an iPad) on the LAN.
# Production server: set PY_HOST=127.0.0.1 so port 8443 only answers on
# localhost — put a reverse proxy (nginx / the Next.js app) in front instead
# of exposing this port directly to the internet.
# PY_HOST=127.0.0.1
# PY_PORT=8443

# Whether requests with NO Authorization header are still allowed to consume
# LLM/ASR/TTS (dev convenience). MUST be false in production, otherwise
# anyone who can reach this server can use your paid API keys for free with
# no login at all.
# QUOTA_FAIL_OPEN_ANON=false

# KET speaking coach: Java calls this loopback-only port. 0 disables the bridge.
COACH_INTERNAL_PORT=8444
# Azure credentials are server-only; never place them in NEXT_PUBLIC_* variables.
# Missing credentials preserve language feedback and show "not configured" for audio.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_LANGUAGE=en-GB
